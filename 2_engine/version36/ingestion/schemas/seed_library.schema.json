{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seed Library",
  "type": "object",
  "required": [
    "asset_id",
    "asset_type",
    "domain",
    "version",
    "status",
    "sources",
    "items"
  ],
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "asset_type": {
      "const": "seed_library"
    },
    "domain": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "family",
          "source_file"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "source_file": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}