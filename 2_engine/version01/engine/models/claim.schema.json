{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim",
  "type": "object",
  "required": [
    "claim_id",
    "text",
    "type",
    "evidence",
    "source"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "meta": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
