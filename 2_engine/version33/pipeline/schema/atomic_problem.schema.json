{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AtomicProblem",
  "description": "A single, self-contained atomic problem generated by the pipeline.",
  "type": "object",
  "required": ["problem_id", "title", "problem_statement", "category", "difficulty", "source_run_id"],
  "additionalProperties": false,
  "properties": {
    "problem_id": {
      "type": "string",
      "description": "Unique identifier. Format: ap_XXXXXX",
      "pattern": "^ap_[a-zA-Z0-9_]{6,}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "Short, descriptive title for the problem."
    },
    "problem_statement": {
      "type": "string",
      "minLength": 20,
      "description": "The complete, self-contained problem statement."
    },
    "category": {
      "type": "string",
      "minLength": 2,
      "description": "Thematic category this problem belongs to."
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard", "expert"],
      "description": "Estimated difficulty level."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Optional keyword tags."
    },
    "solution_hint": {
      "type": "string",
      "description": "Optional hint or solution sketch."
    },
    "source_run_id": {
      "type": "string",
      "description": "Run ID that generated this problem."
    },
    "content_state": {
      "type": "string",
      "enum": ["candidate", "verified", "accepted", "superseded", "disputed", "rejected"],
      "description": "Lifecycle state of this artifact."
    },
    "prompt_trace": {
      "type": "object",
      "properties": {
        "generation_prompt_version": { "type": "string" },
        "generation_prompt_hash": { "type": "string" }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
