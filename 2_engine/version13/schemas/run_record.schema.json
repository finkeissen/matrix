{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "run_record.schema.json",
  "title": "RunRecord",
  "description": "Top-level run metadata. Version 2.0.0: adds subdomain_id, clarification_rounds (E-01), prior_run_id (E-07). kb_snapshot_id = sha256(seed file) (E-03).",
  "type": "object",
  "required": ["run_id", "session_id", "kb_snapshot_id", "subdomain_id", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "run_id":             { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{3}$" },
    "session_id":         { "type": "string" },
    "kb_snapshot_id":     {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256 of seeds/seed_atomare_probleme.csv. Computed at preflight (E-03)."
    },
    "subdomain_id":       { "type": "string", "pattern": "^SD-[0-9]{3}$" },
    "subdomain_label":    { "type": "string" },
    "system_version":     { "type": "string", "default": "2.0.0" },
    "status": {
      "type": "string",
      "enum": ["init", "preflight", "planned", "running", "finalizing", "done", "stop"]
    },
    "created_at":           { "type": "string", "format": "date-time" },
    "completed_at":         { "type": ["string", "null"] },
    "envelopes_total":      { "type": "integer", "minimum": 0 },
    "envelopes_complete":   { "type": "integer", "minimum": 0 },
    "envelopes_pending":    { "type": "integer", "minimum": 0 },
    "clarification_rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "default": 0,
      "description": "Number of clarification rounds completed. STOP if >= 2 before next dispatch (E-01)."
    },
    "category_count":       { "type": ["integer", "null"], "minimum": 0 },
    "prior_run_id": {
      "type": ["string", "null"],
      "description": "Set on re-runs (E-07). Enables delta computation via run_log.jsonl."
    }
  }
}
