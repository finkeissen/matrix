{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "envelope.schema.json",
  "title": "TaskEnvelope",
  "description": "Immutable declaration of a single GIA pipeline execution unit.",
  "type": "object",
  "required": [
    "envelope_version", "task_id", "run_id", "session_id",
    "step", "parent_step", "type", "inputs",
    "expected_outputs", "policy", "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope_version": { "type": "string", "enum": ["1.0.0"] },
    "task_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Content-addressed: sha256(step + sorted input hashes)"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{3}$",
      "description": "Format: YYYY-MM-DD_NNN"
    },
    "session_id": { "type": "string" },
    "step": {
      "type": "string",
      "enum": [
        "01_parsing_01_extraction",
        "01_parsing_02_confidence",
        "02_retrieval",
        "03_enrichment_01_terminology",
        "03_enrichment_02_unit_normalization",
        "03_enrichment_03_gap_detection",
        "04_hypothesis",
        "05_validation",
        "06_clarification",
        "07_examination_01_weakness_scan",
        "07_examination_02_alternative_check",
        "08_finalization",
        "09_commit"
      ]
    },
    "parent_step": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["llm", "deterministic"],
      "description": "Determines scheduling priority and retry behaviour. deterministic runs before llm."
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "description": "Flat map of input name to hash or scalar. No raw content — only references."
    },
    "input_snapshot_id": {
      "type": ["string", "null"],
      "description": "KB snapshot this step operates on. Required for retrieval and validation steps."
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "path", "required"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "description": "Logical name used by downstream steps." },
          "path": { "type": "string", "description": "Deterministic canonical path under run directory." },
          "required": { "type": "boolean", "description": "If true, missing output triggers STOP." }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["retries", "novelty_guard"],
      "additionalProperties": false,
      "properties": {
        "retries":       { "type": "integer", "minimum": 0, "maximum": 3, "default": 1 },
        "timeout_sec":   { "type": ["integer", "null"], "minimum": 1 },
        "priority":      { "type": "string", "enum": ["high", "normal", "low"], "default": "normal" },
        "novelty_guard": { "type": "boolean", "description": "If true, check cache before LLM dispatch." },
        "cache_scope":   { "type": "string", "enum": ["run", "cross_run"], "default": "cross_run" },
        "require_same_snapshot": { "type": "boolean", "default": true }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_by", "created_at"],
      "additionalProperties": false,
      "properties": {
        "created_by":     { "type": "string" },
        "created_at":     { "type": "string", "format": "date-time" },
        "parent_task_id": { "type": ["string", "null"] },
        "reason":         { "type": "string" }
      }
    }
  }
}
