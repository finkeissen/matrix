{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stop_record.schema.json",
  "title": "StopRecord",
  "description": "Written atomically to stop_record.json on STOP. STOP is a valid outcome.",
  "type": "object",
  "required": ["run_id", "stop_code", "recoverable", "stage", "reason", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "run_id":     { "type": "string" },
    "session_id": { "type": "string" },
    "stop_code": {
      "type": "string",
      "enum": [
        "preflight_snapshot_missing",
        "preflight_dir_unwritable",
        "preflight_input_empty",
        "manifest_integrity_mismatch",
        "required_output_missing",
        "deterministic_step_error",
        "llm_output_invalid",
        "no_novelty_on_retry",
        "loop_limit_exceeded",
        "clarification_limit_exceeded",
        "audit_write_failure",
        "policy_violation"
      ]
    },
    "recoverable": {
      "type": "boolean",
      "description": "true = external condition may change; resume may succeed. false = code or data fix required."
    },
    "stage":   { "type": "string" },
    "task_id": { "type": ["string", "null"] },
    "reason":  { "type": "string", "description": "Human-readable one-line explanation." },
    "details": {
      "type": "object",
      "description": "Step-specific diagnostic payload.",
      "additionalProperties": true
    },
    "snapshot_before_stop": { "type": ["string", "null"], "description": "Snapshot ID created just before STOP." },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
