# Matrix Engine - zentrale Konfiguration
# Diese Datei kann von systemd (EnvironmentFile=) und Shell-Skripten (source) gelesen werden.

# Wo die Runs in RAM liegen (tmpfs empfohlen)
MATRIX_RUNS_ROOT="/home/ef/ram/runs"

# Wohin fertige Runs (done/failed) append-only archiviert werden (SSD)
MATRIX_ARCHIVE_ROOT="/home/ef/Beruflich/GitHub/3.matrix (artifacts)/2.runs"

# Pfad zum Engine-Repository (für systemd WorkingDirectory)
MATRIX_ENGINE_ROOT="/home/ef/Beruflich/GitHub/3.matrix (artifacts)/1.engine"

# Daemon-Parameter
MATRIX_POLL_SEC="1.0"

# Python-Interpreter
MATRIX_PYTHON="/usr/bin/env python3"
