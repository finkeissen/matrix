{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "Manifest",
  "description": "Artifact registry. Written atomically. Source of truth for resume and audit.",
  "type": "object",
  "required": ["run_id", "manifest_version", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "run_id":           { "type": "string" },
    "manifest_version": { "type": "string", "enum": ["1.0.0"] },
    "kb_snapshot_id":   { "type": "string" },
    "last_updated_at":  { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "object",
      "description": "Keys are sha256:<hex> artifact hashes.",
      "patternProperties": {
        "^sha256:[a-f0-9]{64}$": {
          "type": "object",
          "required": ["path", "step", "task_id", "output_key", "content_state", "created_at"],
          "additionalProperties": false,
          "properties": {
            "path":          { "type": "string" },
            "step":          { "type": "string" },
            "task_id":       { "type": "string" },
            "output_key":    { "type": "string" },
            "content_state": {
              "type": "string",
              "enum": ["candidate", "verified", "disputed", "accepted", "superseded", "rejected"]
            },
            "created_at":    { "type": "string", "format": "date-time" },
            "size_bytes":    { "type": "integer", "minimum": 0 },
            "reused_from":   { "type": ["string", "null"], "description": "run_id if artifact reused via novelty guard." },
            "supersedes":    { "type": ["string", "null"], "description": "sha256 hash of artifact this replaces." }
          }
        }
      },
      "additionalProperties": false
    },
    "completed_task_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
      "description": "Used by resume skip logic. Append-only."
    }
  }
}
