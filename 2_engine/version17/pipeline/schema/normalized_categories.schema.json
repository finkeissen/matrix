{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "normalized_categories.schema.json",
  "title": "NormalizedCategories",
  "type": "object",
  "required": ["subdomain", "subdomain_id", "category_count", "duplicates_removed", "items"],
  "additionalProperties": false,
  "properties": {
    "subdomain":          { "type": "string", "minLength": 1 },
    "subdomain_id":       { "type": "string", "pattern": "^SD-\\d{3}$" },
    "category_count":     { "type": "integer", "minimum": 1 },
    "duplicates_removed": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "name_normalized", "name_original", "description",
                     "estimated_problem_count"],
        "additionalProperties": false,
        "properties": {
          "index":                  { "type": "integer", "minimum": 1 },
          "name_normalized":        { "type": "string", "minLength": 1 },
          "name_original":          { "type": "string", "minLength": 1 },
          "description":            { "type": "string", "minLength": 1 },
          "canonical_chapter_ref":  { "type": ["integer", "null"] },
          "estimated_problem_count": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
