{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scope.schema.json",
  "title": "Scope",
  "type": "object",
  "required": ["subdomain", "subdomain_id", "parent_domain", "canonical_source",
               "boundaries", "exclusions", "ambiguities"],
  "additionalProperties": true,
  "properties": {
    "subdomain":        { "type": "string", "minLength": 1 },
    "subdomain_id":     { "type": "string", "pattern": "^SD-\\d{3}$" },
    "parent_domain":    { "type": "string", "minLength": 1 },
    "canonical_source": { "type": "string", "minLength": 1 },
    "boundaries": {
      "type": "array", "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "exclusions": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "ambiguities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["topic", "resolution"],
        "properties": {
          "topic":      { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "refinement_round": { "type": "integer", "minimum": 0 },
    "changes_made": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "change"],
        "properties": {
          "field":  { "type": "string" },
          "change": { "type": "string" }
        }
      }
    }
  }
}
